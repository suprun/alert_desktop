# =====================================================================
# Налаштування проксі-сервера тривог (Alerts.in.ua Proxy)
# =====================================================================

# Обов'язково: ваш токен API від devs.alerts.in.ua
ALERTS_API_TOKEN=your_token_here

# Upstream URL для отримання актуальних тривог
UPSTREAM_API_URL=https://api.alerts.in.ua/v1/alerts/active.json

# Інтервал опитування upstream API у секундах (рекомендовано 12-15 сек, не менше 10)
POLL_INTERVAL_SECONDS=15

# Хост та порт для прослуховування вхідних з'єднань від додатків alert_desktop
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Рівень логування (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
