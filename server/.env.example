# =====================================================================
# Налаштування шлюзу тривог (UkraineAlarm Webhook & WebSocket Proxy)
# =====================================================================

# Обов'язково: ваш токен API від api.ukrainealarm.com
ALERTS_API_TOKEN=your_token_here

# Upstream URL для взаємодії з UkraineAlarm
UPSTREAM_API_URL=https://api.ukrainealarm.com

# Публічний URL нашого сервера для прийому Webhook від UkraineAlarm
PUBLIC_WEBHOOK_URL=https://api.applink.pp.ua/api/v3/webhook

# Інтервал фонової повторної синхронізації тривог у секундах (за замовчуванням 300 сек = 5 хв)
RESYNC_INTERVAL_SECONDS=300

# Хост та порт для прослуховування вхідних з'єднань від додатків alert_desktop
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Рівень логування (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
