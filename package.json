{
  "name": "alert-desktop",
  "version": "1.0.50",
  "description": "Десктопний клієнт для моніторингу повітряних тривог на базі Electron",
  "main": "src/main/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/suprun/alert_desktop.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --check src/main/main.js && node --check src/main/config.js && node --check src/main/autostart.js && node --check src/main/threat-utils.js && node --check src/main/api.js && node --check src/main/tray.js && node --check src/main/window.js && node --check src/main/settings-window.js && node --check src/main/notifier.js && node --check src/main/updater.js && node --check src/preload/preload-main.js && node --check src/preload/preload-settings.js && node --check src/preload/preload-map.js && node --check src/renderer/main/renderer.js && node --check src/renderer/settings/settings.js && node --check scripts/reset_config.js && node --check scripts/build_installer.js && node --check scripts/release_tag.js && node --check scripts/test_updater.js && node --check scripts/test_autostart_sync.js && node scripts/test_threat_utils.js && node scripts/test_notifier.js && node scripts/test_oblast_aggregation.js && node scripts/test_updater.js && node scripts/test_autostart_sync.js && electron --no-sandbox scripts/smoke_test.js",
    "build:ico": "electron scripts/generate_ico.js",
    "build:installer": "node scripts/build_installer.js --win",
    "dist": "node scripts/build_installer.js --win",
    "dist:win": "node scripts/build_installer.js --win",
    "dist:win:all": "node scripts/build_installer.js --win",
    "dist:win:x64": "node scripts/build_installer.js --win-x64",
    "dist:win:arm64": "node scripts/build_installer.js --win-arm64",
    "dist:web": "node scripts/build_installer.js --web",
    "dist:linux": "node scripts/build_installer.js --linux",
    "dist:mac": "node scripts/build_installer.js --mac",
    "dist:all": "node scripts/build_installer.js --all",
    "reset:config": "node scripts/reset_config.js",
    "release:tag": "node scripts/release_tag.js"
  },
  "keywords": [
    "electron",
    "alerts",
    "ukraine",
    "tray",
    "monitoring"
  ],
  "author": "suprun <https://github.com/suprun>",
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "ua.in.alerts.desktop",
    "productName": "AlertDesktop",
    "copyright": "Copyright © 2026 suprun. Website alerts.in.ua is property of its respective owners.",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "nsis-web",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icons/app-icon.ico",
      "artifactName": "${productName}-${arch}-Setup-v${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Повітряні тривоги",
      "uninstallDisplayName": "Повітряні тривоги",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "runAfterFinish": true,
      "include": "installer/installer.nsh",
      "warningsAsErrors": false,
      "installerLanguages": [
        "uk_UA",
        "en_US"
      ],
      "language": "1058",
      "displayLanguageSelector": true,
      "buildUniversalInstaller": true,
      "artifactName": "${productName}-${arch}-Setup-v${version}.${ext}"
    },
    "nsisWeb": {
      "artifactName": "${productName}-Web-Setup-v${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal",
            "x64",
            "arm64"
          ]
        },
        {
          "target": "pkg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icons/app-icon.png",
      "artifactName": "${productName}-${arch}-v${version}.${ext}",
      "darkModeSupport": true,
      "minimumSystemVersion": "10.15.0",
      "identity": null,
      "forceCodeSigning": false
    },
    "dmg": {
      "title": "AlertDesktop ${version}",
      "artifactName": "${productName}-${arch}-v${version}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "maintainer": "AlertDesktop <alerts@in.ua>",
      "category": "Utility",
      "icon": "assets/icons/app-icon.png",
      "artifactName": "${productName}-${arch}-v${version}.${ext}"
    },
    "deb": {
      "packageCategory": "utils",
      "priority": "optional"
    },
    "publish": {
      "provider": "github",
      "owner": "suprun",
      "repo": "alert_desktop"
    }
  }
}
