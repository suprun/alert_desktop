{
  "name": "alert-desktop",
  "version": "1.0.102",
  "description": "Десктопний клієнт для моніторингу повітряних тривог на базі Electron",
  "main": "src/main/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/suprun/alert_desktop.git"
  },
  "scripts": {
    "start": "electron .",
    "start:metered": "electron . --mock-metered",
    "test": "node --check src/main/main.js && node --check src/main/config.js && node --check src/main/autostart.js && node --check src/main/threat-utils.js && node --check src/main/history-service.js && node --check src/main/api.js && node --check src/main/net-check.js && node --check src/main/tray.js && node --check src/main/window.js && node --check src/main/settings-window.js && node --check src/main/notifier.js && node --check src/main/updater.js && node --check src/preload/preload-main.js && node --check src/preload/preload-settings.js && node --check src/preload/preload-map.js && node --check src/renderer/main/map-data.js && node --check src/renderer/main/renderer.js && node --check src/renderer/settings/settings.js && node --check scripts/reset_config.js && node --check scripts/build_installer.js && node --check scripts/release_tag.js && node --check scripts/test_updater.js && node --check scripts/test_autostart_sync.js && node --check scripts/test_ubilling_adapter.js && node --check scripts/test_neptun_adapter.js && node --check scripts/test_jaam_adapter.js && node --check scripts/test_net_check.js && node --check scripts/test_fallback_resilience.js && node --check scripts/test_history_service.js && node --check scripts/test_maps_tabs.js && node --check scripts/test_settings_ui.js && node --check scripts/test_api_token_validation.js && node --check scripts/test_icon_centralization.js && node scripts/test_threat_utils.js && node scripts/test_notifier.js && node scripts/test_oblast_aggregation.js && node scripts/test_updater.js && node scripts/test_autostart_sync.js && node scripts/test_ubilling_adapter.js && node scripts/test_neptun_adapter.js && node scripts/test_jaam_adapter.js && node scripts/test_net_check.js && node scripts/test_fallback_resilience.js && node scripts/test_history_service.js && node scripts/test_maps_tabs.js && node scripts/test_settings_ui.js && node scripts/test_api_token_validation.js && node scripts/test_icon_centralization.js && electron scripts/smoke_test.js",
    "build:ico": "electron scripts/generate_ico.js",
    "build:appx": "electron scripts/generate_appx_assets.js",
    "build:installer": "node scripts/build_installer.js --win",
    "dist": "node scripts/build_installer.js --win",
    "dist:win": "node scripts/build_installer.js --win",
    "dist:win:all": "node scripts/build_installer.js --win",
    "dist:win:x64": "node scripts/build_installer.js --win-x64",
    "dist:win:arm64": "node scripts/build_installer.js --win-arm64",
    "dist:msix": "node scripts/build_installer.js --msix",
    "dist:msix:x64": "node scripts/build_installer.js --msix-x64",
    "dist:msix:arm64": "node scripts/build_installer.js --msix-arm64",
    "dist:portable": "node scripts/build_installer.js --portable",
    "dist:portable:x64": "node scripts/build_installer.js --portable-x64",
    "dist:portable:arm64": "node scripts/build_installer.js --portable-arm64",
    "dist:web": "node scripts/build_installer.js --web",
    "dist:linux": "node scripts/build_installer.js --linux",
    "dist:snap": "node scripts/build_installer.js --snap",
    "dist:snap:x64": "node scripts/build_installer.js --snap-x64",
    "dist:snap:arm64": "node scripts/build_installer.js --snap-arm64",
    "dist:flatpak": "node scripts/build_installer.js --flatpak",
    "dist:flatpak:x64": "node scripts/build_installer.js --flatpak-x64",
    "dist:flatpak:arm64": "node scripts/build_installer.js --flatpak-arm64",
    "dist:mac": "node scripts/build_installer.js --mac",
    "dist:all": "node scripts/build_installer.js --all",
    "deploy:server": "python scripts/deploy_remote.py",
    "reset:config": "node scripts/reset_config.js",
    "release:tag": "node scripts/release_tag.js"
  },
  "keywords": [
    "electron",
    "alerts",
    "ukraine",
    "tray",
    "monitoring"
  ],
  "author": "suprun <https://github.com/suprun>",
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "ua.in.alerts.desktop",
    "productName": "AlertDesktop",
    "copyright": "Copyright © 2026 suprun. Website alerts.in.ua is property of its respective owners.",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "nsis-web",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icons/app-icon.ico",
      "artifactName": "${productName}-${arch}-Setup-v${version}.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "Copyright © suprun"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Повітряні тривоги",
      "uninstallDisplayName": "Повітряні тривоги",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "runAfterFinish": true,
      "include": "installer/installer.nsh",
      "warningsAsErrors": false,
      "installerLanguages": [
        "uk_UA",
        "en_US"
      ],
      "language": "1058",
      "displayLanguageSelector": true,
      "buildUniversalInstaller": true,
      "artifactName": "${productName}-${arch}-Setup-v${version}.${ext}"
    },
    "nsisWeb": {
      "artifactName": "${productName}-Web-Setup-v${version}.${ext}"
    },
    "appx": {
      "artifactName": "${productName}-${arch}-v${version}.msix",
      "backgroundColor": "#0f172a",
      "displayName": "AlertDesktop",
      "identityName": "suprun.AlertDesktop",
      "publisher": "CN=suprun",
      "publisherDisplayName": "suprun",
      "languages": [
        "uk-UA",
        "en-US"
      ],
      "showNameOnTiles": false,
      "addAutoLaunchExtension": true
    },
    "portable": {
      "artifactName": "${productName}-${arch}-Portable-v${version}.${ext}",
      "requestExecutionLevel": "user",
      "splashImage": null
    },
    "snap": {
      "summary": "Оперативний десктопний клієнт моніторингу повітряних тривог",
      "category": "Utility",
      "grade": "stable",
      "confinement": "strict",
      "autoStart": true
    },
    "flatpak": {
      "license": "LICENSE",
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "24.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "24.08",
      "finishArgs": [
        "--socket=wayland",
        "--socket=x11",
        "--share=ipc",
        "--device=dri",
        "--socket=pulseaudio",
        "--share=network",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.kde.StatusNotifierWatcher"
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal",
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icons/app-icon.png",
      "artifactName": "${productName}-${arch}-v${version}.${ext}",
      "darkModeSupport": true,
      "minimumSystemVersion": "10.15.0",
      "identity": null,
      "forceCodeSigning": false
    },
    "dmg": {
      "title": "AlertDesktop ${version}",
      "artifactName": "${productName}-${arch}-v${version}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "maintainer": "AlertDesktop <alerts@in.ua>",
      "category": "Utility",
      "icon": "assets/icons/app-icon.png",
      "artifactName": "${productName}-${arch}-v${version}.${ext}"
    },
    "deb": {
      "packageCategory": "utils",
      "priority": "optional"
    },
    "publish": {
      "provider": "github",
      "owner": "suprun",
      "repo": "alert_desktop"
    }
  }
}
