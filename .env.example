# API ключ для devs.alerts.in.ua (якщо використовується напряму без ретранслятора)
ALERTS_API_KEY=

# URL сервера або централізованого ретранслятора тривог
# Якщо використовується власний проксі (з папки server/): http://<server-ip>:8080/v1/alerts/active.json
ALERTS_API_URL=https://api.alerts.in.ua/v1/alerts/active.json

# Інтервал опитування сервера у мілісекундах (рекомендовано не частіше 10-15 сек)
ALERTS_POLL_INTERVAL=15000
